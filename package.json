{
  "name": "pandabase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "lint": "pnpm -r --if-present lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @pandabase/db generate",
    "db:migrate": "pnpm --filter @pandabase/db migrate",
    "db:migrate:prod": "pnpm --filter @pandabase/db migrate:prod",
    "db:seed": "pnpm --filter @pandabase/db seed",
    "db:reset": "pnpm --filter @pandabase/db reset",
    "db:rebuild-state": "pnpm --filter @pandabase/db rebuild-state",
    "drizzle-kit": "pnpm --filter @pandabase/db exec drizzle-kit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2"
  }
}
