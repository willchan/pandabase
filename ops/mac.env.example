# Mac Mini runtime env: the worker (docker compose) and the agent tools (OpenClaw).
# `make secrets` copies this to the repo-root `.env` (mode 600, gitignored) and fills in the
# tokens. Never commit `.env`. See README "Where each secret lives" and DESIGN §8.

# --- shared with Vercel (same values in the Vercel project's env; `make vercel-env`) ---
AGENT_API_TOKEN=
WORKER_API_TOKEN=

# --- State Engine ---
# Your production URL (Vercel). The tools and worker call /api/* on it.
PANDABASE_API_URL=https://pandabase.example.vercel.app
HOUSEHOLD_TZ=America/Los_Angeles

# --- worker (DESIGN §1.2, PLAN M6 Notes) ---
# Inside the container; compose maps host.docker.internal to the host.
OLLAMA_URL=http://host.docker.internal:11434
# The model OpenClaw's agents keep loaded, so a job never swaps it out (README "Memory budget").
OLLAMA_VLM_MODEL=qwen3.8:27b
OLLAMA_TEXT_MODEL=qwen3.8:27b
POLL_INTERVAL_SECONDS=10

# --- agent tools (DESIGN §6) ---
# Absolute path; `make secrets` fills it with <repo>/agent/pandabase.config.json.
PANDABASE_CONFIG=

# --- OpenClaw (README step 11) ---
# Id of the `pandabase` agent in the gateway's agents.list: the agent bound to #pandabase that runs
# PandaBase's automations. The gateway can host other agents; this names PandaBase's. Unset, the
# scripts use `main` (the old single agent).
OPENCLAW_AGENT=pandabase

# --- smoke / ops (host side) ---
# Ollama as seen from the Mac itself (not from the container).
HOST_OLLAMA_URL=http://127.0.0.1:11434
# Browser binary for the per-member LaunchAgents: Google Chrome (Homebrew's `chromium` cask was
# disabled on 2026-09-01). Any Chromium build works; for Chromium itself use the commented line.
CHROMIUM_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROMIUM_BIN=/Applications/Chromium.app/Contents/MacOS/Chromium

# --- continuous deployment (README step 15; PLAN M9) ---
# Worker image tag compose runs; `make update` pins it to the deployed sha. Leave as is.
PANDABASE_WORKER_TAG=main
# #pandabase channel webhook for "update failed, rolled back" posts (a secret: anyone with the
# URL can post). Optional; without it failures only go to the log and telemetry.
DEPLOY_DISCORD_WEBHOOK_URL=
