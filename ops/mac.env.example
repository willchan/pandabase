# Mac Mini runtime env: the worker (docker compose) and the agent tools (OpenClaw).
# `make secrets` copies this to the repo-root `.env` (mode 600, gitignored) and fills in the
# tokens. Never commit `.env`. See README "Where each secret lives" and DESIGN §8.

# --- shared with Vercel (same values in the Vercel project's env; `make vercel-env`) ---
AGENT_API_TOKEN=
WORKER_API_TOKEN=

# --- State Engine ---
# Your production URL (Vercel). The tools and worker call /api/* on it.
PANDABASE_API_URL=https://pandabase.example.vercel.app
HOUSEHOLD_TZ=America/Los_Angeles

# --- worker (DESIGN §1.2, PLAN M6 Notes) ---
# Inside the container; compose maps host.docker.internal to the host.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VLM_MODEL=qwen3.5:9b
# Set to qwen3.5:9b to keep a single model resident (see README "Memory budget").
OLLAMA_TEXT_MODEL=qwen3.5:4b
POLL_INTERVAL_SECONDS=10

# --- agent tools (DESIGN §6) ---
# Absolute path; `make secrets` fills it with <repo>/agent/pandabase.config.json.
PANDABASE_CONFIG=

# --- smoke / ops (host side) ---
# Ollama as seen from the Mac itself (not from the container).
HOST_OLLAMA_URL=http://127.0.0.1:11434
# Chromium binary for the per-member LaunchAgents.
CHROMIUM_BIN=/Applications/Chromium.app/Contents/MacOS/Chromium
