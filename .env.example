# Copy to .env.local (web) / .env (worker, agent tools). Never commit real values.
# See docs/DESIGN.md §8. Values below are placeholders.

# --- web (State Engine) ---
# Unset → db/dev.db (absolute, shared by every package). A relative file: URL resolves against
# the cwd of whichever package runs, so prefer leaving it unset locally.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=
AGENT_API_TOKEN=
WORKER_API_TOKEN=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
HOUSEHOLD_TZ=America/Los_Angeles
DEV_AUTH_BYPASS=1

# --- worker ---
PANDABASE_API_URL=http://localhost:3000
# WORKER_API_TOKEN=   (same as above)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_VLM_MODEL=
POLL_INTERVAL_SECONDS=10

# --- agent tools ---
# PANDABASE_API_URL=  (same as above)
# AGENT_API_TOKEN=    (same as above)
PANDABASE_CONFIG=
