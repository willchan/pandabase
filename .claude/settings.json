{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm --filter web shot:*)",
      "Bash(pnpm --filter web test:e2e:*)",
      "Bash(pnpm --filter web dev:seeded:*)",
      "Bash(pnpm --filter web data-quality)",
      "Bash(make e2e-system)",
      "Bash(make prod-copy)"
    ],
    "ask": [
      "Bash(make update*)",
      "Bash(make rollback*)",
      "Bash(make vercel-env*)",
      "Bash(make backfill*)",
      "Bash(pnpm --filter web data-quality --names*)"
    ],
    "deny": [
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(npx vercel*--prod*)",
      "Bash(pnpm db:migrate:prod*)",
      "Bash(pnpm --filter @pandabase/db migrate:prod*)",
      "Bash(make deploy*)",
      "Bash(turso db shell*)",
      "Bash(turso db destroy*)",
      "Bash(*TURSO_DATABASE_URL=libsql:*)",
      "Bash(*TURSO_DATABASE_URL=https:*)",
      "Bash(*TURSO_AUTH_TOKEN=*)"
    ]
  }
}
